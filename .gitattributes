# Preserve evidence/source checksums across Linux, WSL and Windows checkouts.
* text=auto eol=lf
*.png binary
*.npz binary
*.gz binary
*.pdf binary

# Preserve Matplotlib-generated SVG path formatting and evidence checksums.
studies/initial/figures/*.svg -whitespace
# Reports preserve the whitespace of captured model generations.
studies/initial/runs/*/report.html -whitespace
